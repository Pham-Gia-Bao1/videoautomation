# Server-side only. Never expose with NEXT_PUBLIC_.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
RENDER_WORKER_URL=
RENDER_WORKER_TOKEN=

# Public project URL and publishable key. Safe for authenticated browser clients.
